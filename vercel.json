{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/termini-e-condizioni-clienti",
      "destination": "/termini-e-condizioni/termini-e-condizioni-acquirenti",
      "permanent": true
    },
    {
      "source": "/termini-e-condizioni-acquirenti",
      "destination": "/termini-e-condizioni/termini-e-condizioni-acquirenti",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/business",
      "destination": "/business-italia"
    },
    {
      "source": "/business-registration",
      "destination": "/store-registration"
    },
    {
      "source": "/homechef-registration",
      "destination": "/home-chef-registration"
    },
    {
      "source": "/termini-e-condizioni/termini-e-condizioni-acquirenti",
      "destination": "/termini-e-condizioni-acquirenti"
    }
  ]
}
